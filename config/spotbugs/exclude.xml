<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions. Each entry is a pattern SpotBugs is right about in general and wrong
  about here; anything not listed is a real finding and fails the build.
-->
<FindBugsFilter>

  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2 on the config records. Every one of these takes its
    collections through a compact constructor that calls List.copyOf/Map.copyOf, so the
    "internal representation" being returned is already immutable — SpotBugs cannot see
    through the factory call. Leaving these on would mean copying twice on every accessor.
  -->
  <Match>
    <Package name="com.achen.shelf.config"/>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!--
    Injected collaborators — the connection pool, the DAOs handed to crawl services, the
    PageCrawler handed to a Worker — are shared on purpose: a pool that were defensively copied
    would not be a pool. LeaderLock.connection() hands out the one session the advisory lock
    lives on, which is the entire point of the class.
  -->
  <Match>
    <Or>
      <Class name="com.achen.shelf.db.Database"/>
      <Class name="com.achen.shelf.crawl.RobotsGate"/>
      <Class name="com.achen.shelf.crawl.CrawlRunner"/>
      <Class name="com.achen.shelf.crawl.CrawlSummary"/>
      <Class name="com.achen.shelf.crawl.ParsedOffer"/>
      <Class name="com.achen.shelf.crawl.PageCrawler"/>
      <Class name="com.achen.shelf.crawl.cluster.Worker"/>
      <Class name="com.achen.shelf.crawl.cluster.LeaderLock"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

</FindBugsFilter>
